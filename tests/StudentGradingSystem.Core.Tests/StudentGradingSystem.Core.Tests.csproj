<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>StudentGradingSystem.Core.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StudentGradingSystem.Core\StudentGradingSystem.Core.csproj" />
    <ProjectReference Include="..\..\src\StudentGradingSystem.Data.MySql\StudentGradingSystem.Data.MySql.csproj" />
    <ProjectReference Include="..\..\src\StudentGradingSystem.Data.InMemory\StudentGradingSystem.Data.InMemory.csproj" />
  </ItemGroup>

  <!-- Integration tests build a throwaway database from the real scripts. -->
  <ItemGroup>
    <None Include="..\..\database\01-schema.sql" Link="Database\01-schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\database\02-seed.sql" Link="Database\02-seed.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
