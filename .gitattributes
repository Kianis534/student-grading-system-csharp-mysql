# Normalize line endings in the repository; check out with the platform default.
* text=auto

# Windows-only files keep CRLF
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.config    text eol=crlf
*.manifest  text eol=crlf
*.resx      text eol=crlf
*.cs        text eol=crlf diff=csharp
*.ps1       text eol=crlf

# Unix-style files
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.md        text eol=lf diff=markdown

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.dll  binary
*.exe  binary
