<?xml version="1.0" encoding="utf-8"?>
<!--
  Student Grading System - local database settings (template)

  1. Copy this file to "Database.config" in the same folder.
     (Building the project from source does this for you the first time.)
  2. Replace YOUR_MYSQL_PASSWORD (and the user/host if needed) with your own values.
     You can also do this from the app: Login screen > "Database settings".

  Database.config is git-ignored. Never commit real credentials.
  The SGS_CONNECTION_STRING environment variable, if set, takes precedence over this file.
-->
<appSettings>
  <add key="SGS.ConnectionString"
       value="Server=localhost;Port=3306;Database=StudentGradingSystem;User ID=root;Password=YOUR_MYSQL_PASSWORD;SslMode=Preferred;AllowPublicKeyRetrieval=True" />
</appSettings>
