@page "/instructor/courses/{CourseId:int}"
@inherits DemoPage

<PageTitle>@(_course?.Code ?? "Course") - Student Grading System demo</PageTitle>

@if (_course is null)
{
    return;
}

<DesktopWindow Title="@($"Student Grading System - {_course.Code}")" Width="980" Height="640" OnClose="Back" CloseLabel="Close (back to courses)"
               HeaderTitle="@_course.DisplayName"
               HeaderSubtitle="@($"{_course.Semester}{Dot}{_course.EnrolledStudents} students enrolled{Dot}{_activities.Count} assessments")">
    <div class="win-content">
        <div class="grid-wrap" tabindex="0" @onkeydown="OnGridKey">
            <table class="grid">
                <thead>
                    <tr>
                        <th class="fill">Assessment</th>
                        <th class="num" style="width:140px">Total marks</th>
                        <th class="num" style="width:140px">Weightage</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _activities.Count; i++)
                    {
                        int index = i;
                        Activity activity = _activities[i];
                        <tr class="selectable @(index == _selected ? "selected" : "")" @onclick="() => _selected = index" @ondblclick="EnterMarks">
                            <td>@activity.Name</td>
                            <td class="num">@Format(activity.TotalMarks)</td>
                            <td class="num">@Format(activity.Weightage)%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="add-panel">
        <h3>Add an assessment</h3>
        <form class="add-row" @onsubmit="Add" @onsubmit:preventDefault>
            <div class="name">
                <label class="field-label" for="name">Name (pick one or type your own)</label>
                <input id="name" class="textbox" type="text" list="suggestions" maxlength="@ActivityRules.MaxNameLength" @bind="_newName" />
                <datalist id="suggestions">
                    @foreach (string suggestion in ActivityRules.SuggestedNames)
                    {
                        <option value="@suggestion"></option>
                    }
                </datalist>
            </div>
            <div class="num">
                <label class="field-label" for="total">Total marks</label>
                <input id="total" class="textbox" type="number" min="0.01" max="1000" step="0.01" @bind="_newTotal" />
            </div>
            <div class="num">
                <label class="field-label" for="weight">Weightage (%)</label>
                <input id="weight" class="textbox" type="number" min="0.01" max="100" step="0.01" @bind="_newWeight" />
            </div>
            <button type="submit" class="btn btn-success btn-small" style="min-width:150px" disabled="@(Remaining == 0)">Add assessment</button>
        </form>
        <div class="weight-box">
            <h4>Final grade weightage</h4>
            <div class="progress"><span style="width:@(Math.Min(100m, Allocated).ToString("0.##"))%"></span></div>
            <div class="value @(Remaining == 0 ? "ok" : "")">
                @(Remaining == 0 ? $"{Format(Allocated)}% allocated - ready to grade" : $"{Format(Allocated)}% allocated{Dot}{Format(Remaining)}% remaining")
            </div>
        </div>
    </div>

    <div class="win-footer">
        <button class="btn btn-secondary" style="min-width:150px" @onclick="Back">Back to courses</button>
        <div class="right">
            <button class="btn btn-danger" disabled="@(_selected < 0)" @onclick="Delete">Delete</button>
            <button class="btn btn-success" style="min-width:130px" disabled="@(_selected < 0)" @onclick="EnterMarks">Enter marks</button>
            <button class="btn btn-secondary" style="min-width:130px" @onclick="ViewGrades">View grades</button>
            <button class="btn btn-primary" style="min-width:160px" disabled="@(_activities.Count == 0)" @onclick="Calculate">Calculate grades</button>
        </div>
    </div>
</DesktopWindow>

@code {
    [Parameter]
    public int CourseId { get; set; }

    private CourseSummary? _course;
    private IReadOnlyList<Activity> _activities = Array.Empty<Activity>();
    private int _selected = -1;
    private string _newName = string.Empty;
    private decimal _newTotal = 10;
    private decimal _newWeight = 10;

    private decimal Allocated => _activities.Sum(a => a.Weightage);

    private decimal Remaining => Math.Max(0m, ActivityRules.MaxCourseWeightage - Allocated);

    protected override async Task OnParametersSetAsync()
    {
        if (!EnsureRole(UserRole.Instructor))
        {
            return;
        }

        Load();
        if (_course is null)
        {
            await Dialogs.WarningAsync("This course no longer exists.");
            Back();
        }
    }

    private void Load(int? selectActivityId = null)
    {
        _course = Session.Courses.GetCourse(CourseId);
        _activities = Session.Courses.GetActivities(CourseId);

        int found = selectActivityId is int id ? _activities.ToList().FindIndex(a => a.ActivityId == id) : -1;
        _selected = found >= 0 ? found : _activities.Count > 0 ? Math.Max(0, Math.Min(_selected, _activities.Count - 1)) : -1;

        if (Remaining > 0)
        {
            _newWeight = Math.Max(0.01m, Math.Min(_newWeight, Remaining));
        }
    }

    private async Task Add()
    {
        ValidationResult result = Session.Courses.AddActivity(CourseId, _newName, _newTotal, _newWeight, out Activity? created);
        if (!result.IsValid)
        {
            await Dialogs.WarningAsync(result.Error!);
            return;
        }

        _newName = string.Empty;
        Load(created?.ActivityId);
    }

    private async Task Delete()
    {
        if (_selected < 0)
        {
            return;
        }

        Activity activity = _activities[_selected];
        bool confirmed = await Dialogs.ConfirmAsync(
            $"Delete \"{activity.Name}\" and every mark recorded for it?\n\n" +
            "This can't be undone. Recalculate grades afterwards so final results reflect the change.",
            destructive: true);

        if (confirmed)
        {
            Session.Courses.DeleteActivity(activity.ActivityId);
            Load();
        }
    }

    private void EnterMarks()
    {
        if (_selected >= 0)
        {
            Nav.NavigateTo($"instructor/courses/{CourseId}/assessments/{_activities[_selected].ActivityId}");
        }
    }

    private async Task Calculate()
    {
        if (_activities.Count == 0)
        {
            await Dialogs.WarningAsync("Add at least one assessment before calculating grades.");
            return;
        }

        if (Remaining > 0 && !await Dialogs.ConfirmAsync(
                $"Only {Format(Allocated)}% of the final grade has been allocated to assessments.\n" +
                "Students will be graded out of 100%, so missing weightage counts as zero.\n\n" +
                "Calculate grades anyway?"))
        {
            return;
        }

        Session.Grading.CalculateAndSaveGrades(CourseId);
        Nav.NavigateTo($"instructor/courses/{CourseId}/grades?calculated=true");
    }

    private void ViewGrades() => Nav.NavigateTo($"instructor/courses/{CourseId}/grades");

    private void Back() => Nav.NavigateTo("instructor");

    private async Task OnGridKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                EnterMarks();
                break;
            case "Delete":
                await Delete();
                break;
            default:
                _selected = MoveSelection(e, _selected, _activities.Count);
                break;
        }
    }
}
