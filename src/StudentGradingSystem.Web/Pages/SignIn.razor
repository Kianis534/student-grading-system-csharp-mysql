@page "/"
@inherits DemoPage

<PageTitle>Sign in - Student Grading System demo</PageTitle>

<div class="signin">
    <section class="signin-brand">
        <span class="logo">A+</span>
        <h1>Student Grading System</h1>
        <p>Assessments, marks and weighted final grades for instructors and students.</p>
        <ul>
            <li>Set up quizzes, assignments and exams with weightage</li>
            <li>Enter marks and calculate final grades in one click</li>
            <li>Students see exactly how every mark counts</li>
        </ul>
        <p class="muted-on-blue"><small>This preview runs the same C# grading engine as the desktop app, right in your browser.</small></p>
    </section>

    <section class="signin-form">
        <h2>Try it now</h2>
        <p class="hint">Pick a role to sign in with a demo account. No registration needed.</p>

        <div class="quick">
            <button class="btn btn-primary" disabled="@_busy" @onclick="() => QuickSignIn(DemoAccount.Instructor)">Try as instructor</button>
            <button class="btn btn-success" disabled="@_busy" @onclick="() => QuickSignIn(DemoAccount.Student)">Try as student</button>
        </div>

        <div class="divider">or sign in manually</div>

        <form @onsubmit="SignInAsync" @onsubmit:preventDefault>
            <div class="field">
                <label for="username">Username</label>
                <input id="username" type="text" autocomplete="username" @bind="_username" disabled="@_busy" />
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input id="password" type="password" autocomplete="current-password" @bind="_password" disabled="@_busy" />
            </div>
            <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">@(_busy ? "Signing in..." : "Sign in")</button>
        </form>

        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">@_error</div>
        }

        <p class="creds">
            Demo accounts: <code>instructor</code> / <code>Instructor@123</code>,
            <code>jsmith</code> / <code>Student@123</code> (also <code>ejohnson</code>, <code>mbrown</code>, <code>jgarcia</code>...).
            Everything you change stays in this browser tab only.
        </p>
    </section>
</div>

@code {
    private enum DemoAccount { Instructor, Student }

    private string _username = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (Session.IsSignedIn)
        {
            Nav.NavigateTo(Session.HomeUrl, replace: true);
        }
    }

    private Task QuickSignIn(DemoAccount account)
    {
        (_username, _password) = account == DemoAccount.Instructor
            ? (StudentGradingSystem.Data.InMemory.DemoData.InstructorUsername, StudentGradingSystem.Data.InMemory.DemoData.InstructorPassword)
            : (StudentGradingSystem.Data.InMemory.DemoData.StudentUsername, StudentGradingSystem.Data.InMemory.DemoData.StudentPassword);
        return SignInAsync();
    }

    private async Task SignInAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrEmpty(_password))
        {
            _error = "Enter your username and password.";
            return;
        }

        _busy = true;
        StateHasChanged();
        try
        {
            AuthenticatedUser? user = await Session.SignInAsync(_username, _password);
            if (user is null)
            {
                _error = "Incorrect username or password.";
                _password = string.Empty;
                return;
            }

            Nav.NavigateTo(Session.HomeUrl);
        }
        finally
        {
            _busy = false;
        }
    }
}
