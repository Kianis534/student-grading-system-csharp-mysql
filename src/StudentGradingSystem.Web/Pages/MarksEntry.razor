@page "/instructor/courses/{CourseId:int}/assessments/{ActivityId:int}"
@inherits DemoPage
@inject IJSRuntime JS

<PageTitle>Enter marks - Student Grading System demo</PageTitle>

@if (_course is null || _activity is null)
{
    return;
}

@* Asks before leaving with unsaved marks: Back, the close button, browser back/forward, reload or closing the tab. *@
<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="@IsDirty" />

<DesktopWindow Title="@($"Student Grading System - {_activity.Name}")" Width="860" Height="620" OnClose="Back" CloseLabel="Close (back to the course)"
               HeaderTitle="@($"Enter marks{Dot}{_activity.Name}")"
               HeaderSubtitle="@($"{_course.DisplayName}{Dot}Out of {Format(_activity.TotalMarks)}{Dot}{Format(_activity.Weightage)}% of the final grade")">
    <div class="win-content tight" data-save-shortcut @onkeydown="OnWindowKey">
        <div class="hint-line">
            Type marks in the "Obtained marks" column and press Enter to move to the next student. Leave a cell empty if the student hasn't been marked yet.
        </div>
        <div class="grid-wrap">
            <table class="grid">
                <thead>
                    <tr>
                        <th style="width:110px">Student ID</th>
                        <th class="fill">Student</th>
                        <th class="num" style="width:190px">Obtained marks (/@Format(_activity.TotalMarks))</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _rows.Count; i++)
                    {
                        int index = i;
                        Row row = _rows[i];
                        <tr class="@(index == _current ? "selected" : "")">
                            <td class="muted">@row.StudentId</td>
                            <td>@row.Name</td>
                            <td class="cell-edit">
                                <input id="mark-@index" type="text" inputmode="decimal" autocomplete="off"
                                       aria-label="@($"Obtained marks for {row.Name}")"
                                       class="@(row.Error is null ? "" : "invalid")" title="@row.Error"
                                       value="@row.Text"
                                       @onfocus="() => _current = index"
                                       @oninput="e => OnInput(row, e.Value?.ToString())"
                                       @onkeydown="e => OnCellKey(e, index)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="win-footer">
        <button class="btn btn-secondary" style="min-width:120px" @onclick="Back">Back</button>
        <span class="status @StatusClass">@StatusText</span>
        <div class="right">
            <button class="btn btn-primary" style="min-width:160px" disabled="@(!IsDirty || HasErrors)" @onclick="() => SaveAsync()">Save marks</button>
        </div>
    </div>
</DesktopWindow>

@code {
    [Parameter]
    public int CourseId { get; set; }

    [Parameter]
    public int ActivityId { get; set; }

    private sealed class Row
    {
        public int StudentId { get; init; }

        public string Name { get; init; } = string.Empty;

        public decimal? Saved { get; set; }

        public decimal? Value { get; set; }

        public string Text { get; set; } = string.Empty;

        public string? Error { get; set; }
    }

    private CourseSummary? _course;
    private Activity? _activity;
    private List<Row> _rows = new();
    private int _current;
    private string? _savedAt;

    private bool HasErrors => _rows.Any(r => r.Error is not null);

    private bool IsDirty => HasErrors || _rows.Any(r => r.Value != r.Saved);

    private Row? FirstError => _rows.FirstOrDefault(r => r.Error is not null);

    private string StatusClass => HasErrors ? "error" : IsDirty ? "info" : "";

    private string StatusText
    {
        get
        {
            if (FirstError is { } bad)
            {
                return $"{bad.Name}: {bad.Error} Press Esc to undo.";
            }

            var marked = _rows.Where(r => r.Value.HasValue).ToList();
            string text = $"{marked.Count} of {_rows.Count} students marked";
            if (marked.Count > 0)
            {
                text += $"{Dot}class average {Format(marked.Average(r => r.Value!.Value))} / {Format(_activity!.TotalMarks)}";
            }

            if (IsDirty)
            {
                return text + $"{Dot}unsaved changes";
            }

            return _savedAt is null ? text : text + $"{Dot}Saved at {_savedAt}.";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!EnsureRole(UserRole.Instructor))
        {
            return;
        }

        _course = Session.Courses.GetCourse(CourseId);
        _activity = Session.Courses.GetActivities(CourseId).FirstOrDefault(a => a.ActivityId == ActivityId);
        if (_activity is null)
        {
            await Dialogs.WarningAsync("This assessment no longer exists.");
            Nav.NavigateTo(_course is null ? "instructor" : $"instructor/courses/{CourseId}");
            return;
        }

        _rows = Session.Courses.GetMarks(ActivityId)
            .Select(m => new Row
            {
                StudentId = m.StudentId,
                Name = m.StudentName,
                Saved = m.ObtainedMarks,
                Value = m.ObtainedMarks,
                Text = m.ObtainedMarks?.ToString("0.##") ?? string.Empty,
            })
            .ToList();

        if (_rows.Count == 0)
        {
            await Dialogs.InfoAsync("No students are enrolled in this course yet.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _rows.Count > 0)
        {
            await JS.InvokeVoidAsync("sgsFocus", "mark-0");
        }
    }

    private void OnInput(Row row, string? text)
    {
        _savedAt = null;
        row.Text = text ?? string.Empty;
        string trimmed = row.Text.Trim();

        if (trimmed.Length == 0)
        {
            row.Value = null;
            row.Error = null;
            return;
        }

        if (!decimal.TryParse(trimmed, out decimal value))
        {
            row.Error = "Enter a number, or leave the cell empty.";
            return;
        }

        ValidationResult check = ActivityRules.ValidateObtainedMarks(value, _activity!.TotalMarks);
        row.Value = value;
        row.Error = check.IsValid ? null : check.Error;
    }

    private async Task OnCellKey(KeyboardEventArgs e, int index)
    {
        switch (e.Key)
        {
            case "Enter":
            case "ArrowDown":
                if (index + 1 < _rows.Count)
                {
                    await JS.InvokeVoidAsync("sgsFocus", $"mark-{index + 1}");
                }

                break;
            case "ArrowUp":
                if (index > 0)
                {
                    await JS.InvokeVoidAsync("sgsFocus", $"mark-{index - 1}");
                }

                break;
            case "Escape":
                // Undo the cell back to its saved value, like cancelling a DataGridView edit.
                Row row = _rows[index];
                row.Value = row.Saved;
                row.Text = row.Saved?.ToString("0.##") ?? string.Empty;
                row.Error = null;
                break;
        }
    }

    private async Task OnWindowKey(KeyboardEventArgs e)
    {
        if ((e.CtrlKey || e.MetaKey) && (e.Key == "s" || e.Key == "S"))
        {
            await SaveAsync();
        }
    }

    private async Task<bool> SaveAsync()
    {
        if (HasErrors)
        {
            await Dialogs.WarningAsync($"{FirstError!.Name}: {FirstError.Error}");
            return false;
        }

        var entries = _rows.Select(r => new StudentMarkEntry(r.StudentId, r.Name, r.Value)).ToList();
        ValidationResult result = Session.Courses.SaveMarks(_activity!, entries);
        if (!result.IsValid)
        {
            await Dialogs.WarningAsync(result.Error!);
            return false;
        }

        foreach (Row row in _rows)
        {
            row.Saved = row.Value;
        }

        _savedAt = DateTime.Now.ToString("h:mm tt");
        StateHasChanged();
        return true;
    }

    private void Back() => Nav.NavigateTo($"instructor/courses/{CourseId}");

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        // Nothing to lose, or "Reset demo data" signed the visitor out and there's nowhere left to save to.
        if (!IsDirty || !Session.IsSignedIn)
        {
            return;
        }

        string? answer = await Dialogs.ShowAsync(
            "You have unsaved marks. Save them before leaving?", DialogIcon.Question, "Yes", "No", "Cancel");

        if (answer is null or "Cancel" || (answer == "Yes" && !await SaveAsync()))
        {
            context.PreventNavigation();
        }
    }
}
