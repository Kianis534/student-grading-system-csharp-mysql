@page "/instructor/courses/{CourseId:int}/grades"
@inherits DemoPage
@inject IJSRuntime JS

<PageTitle>Final grades - Student Grading System demo</PageTitle>

@if (_course is null)
{
    return;
}

<DesktopWindow Title="@($"Student Grading System - {_course.Code} grades")" Width="860" Height="620" OnClose="Back" CloseLabel="Close (back to the course)"
               HeaderTitle="Final grades"
               HeaderSubtitle="@($"{_course.DisplayName}{Dot}{_course.Semester}")">
    <div class="stats-block">
        @if (_stats is null || _stats.Count == 0)
        {
            <div class="stats">No grades yet</div>
            <div class="distribution">Open the course and click "Calculate grades" to generate final grades.</div>
        }
        else
        {
            <div class="stats">
                <span>Average @Percent(_stats.Average)</span>
                <span>Highest @Percent(_stats.Highest)</span>
                <span>Lowest @Percent(_stats.Lowest)</span>
                <span>Passed @_stats.Passed of @_stats.Count</span>
            </div>
            <div class="distribution">
                Distribution:&nbsp;
                @foreach (KeyValuePair<string, int> band in _stats.Distribution.Where(d => d.Value > 0))
                {
                    <span>@band.Key × @band.Value</span>
                }
            </div>
        }
    </div>
    <div class="win-content tight">
        <div class="grid-wrap">
            <table class="grid">
                <thead>
                    <tr>
                        <th style="width:110px">Student ID</th>
                        <th class="fill">Student</th>
                        <th class="num" style="width:140px">Percentage</th>
                        <th class="center" style="width:110px">Grade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (StudentGrade grade in _grades)
                    {
                        <tr>
                            <td class="muted">@grade.StudentId</td>
                            <td>@grade.StudentName</td>
                            <td class="num">@Percent(grade.Percentage)</td>
                            <td class="center"><GradeText Grade="@grade.FinalGrade" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="win-footer">
        <button class="btn btn-secondary" style="min-width:120px" @onclick="Back">Back</button>
        <span class="status @(_statusOk ? "ok" : "")">@_status</span>
        <div class="right">
            <button class="btn btn-primary" style="min-width:160px" disabled="@(_grades.Count == 0)" @onclick="ExportAsync">Export to CSV</button>
        </div>
    </div>
</DesktopWindow>

@code {
    [Parameter]
    public int CourseId { get; set; }

    [SupplyParameterFromQuery(Name = "calculated")]
    public bool Calculated { get; set; }

    private CourseSummary? _course;
    private IReadOnlyList<StudentGrade> _grades = Array.Empty<StudentGrade>();
    private GradeStatistics? _stats;
    private string _status = string.Empty;
    private bool _statusOk;

    protected override void OnParametersSet()
    {
        if (!EnsureRole(UserRole.Instructor))
        {
            return;
        }

        _course = Session.Courses.GetCourse(CourseId);
        if (_course is null)
        {
            Nav.NavigateTo("instructor");
            return;
        }

        _grades = Session.Grading.GetGrades(CourseId);
        _stats = GradeStatistics.From(_grades.ToList());

        DateTime? calculatedAt = _grades.Count == 0 ? null : _grades.Max(g => g.CalculatedAt);
        _statusOk = Calculated;
        _status = Calculated
            ? "Grades recalculated just now."
            : calculatedAt is DateTime when ? $"Last calculated {when:g}." : string.Empty;
    }

    private async Task ExportAsync()
    {
        string csv = StudentGradingSystem.Core.Reporting.GradeReportCsv.ToCsv(_grades);
        string fileName = $"{_course!.Code}-final-grades.csv";
        await JS.InvokeVoidAsync("sgsDownloadCsv", fileName, csv);
        _status = $"Exported {_grades.Count} grades to {fileName}.";
        _statusOk = true;
    }

    private void Back() => Nav.NavigateTo($"instructor/courses/{CourseId}");
}
