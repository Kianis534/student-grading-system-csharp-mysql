@page "/student"
@inherits DemoPage

<PageTitle>My courses - Student Grading System demo</PageTitle>

<div class="page-head">
    <h1>Welcome, @Session.User?.DisplayName</h1>
    <p>Your courses and results &middot; open a course to see your marks.</p>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Course</th>
                    <th>Semester</th>
                    <th class="num">Percentage</th>
                    <th class="center">Grade</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (StudentCourseResult course in _courses)
                {
                    <tr class="clickable" @onclick="() => Open(course)">
                        <td class="strong">@course.Code</td>
                        <td>@course.Title</td>
                        <td class="muted">@course.Semester</td>
                        <td class="num">@(course.Percentage is decimal p ? Percent(p) : "-")</td>
                        <td class="center"><GradeBadge Grade="@course.FinalGrade" /></td>
                        <td class="num"><a href="student/courses/@course.CourseId" @onclick:stopPropagation>View marks</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<p class="muted">
    @_courses.Count enrolled courses &middot; @_courses.Count(c => c.IsGraded) graded.
    Tip: open <strong>CS301</strong> for a released grade, or <strong>CS201</strong> to see marks for a course still in progress.
</p>

@code {
    private IReadOnlyList<StudentCourseResult> _courses = Array.Empty<StudentCourseResult>();

    protected override void OnInitialized()
    {
        if (EnsureRole(UserRole.Student))
        {
            _courses = Session.Results.GetCourses(Session.User!.StudentId!.Value);
        }
    }

    private void Open(StudentCourseResult course) => Nav.NavigateTo($"student/courses/{course.CourseId}");
}
