@page "/student"
@inherits DemoPage

<PageTitle>My courses - Student Grading System demo</PageTitle>

<DesktopWindow Title="Student Grading System - My courses" Width="900" Height="580" OnClose="SignOut" FocusHeader="false" CloseLabel="Close (signs out)"
               HeaderTitle="@($"Welcome, {Session.User?.DisplayName}")"
               HeaderSubtitle="@($"Your courses and results{Dot}Double-click a course to see your marks.")">
    <div class="win-content">
        <div class="grid-wrap" tabindex="0" data-autofocus @onkeydown="OnGridKey">
            <table class="grid">
                <thead>
                    <tr>
                        <th style="width:90px">Code</th>
                        <th class="fill">Course</th>
                        <th style="width:120px">Semester</th>
                        <th class="num" style="width:120px">Percentage</th>
                        <th class="center" style="width:120px">Grade</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _courses.Count; i++)
                    {
                        int index = i;
                        StudentCourseResult course = _courses[i];
                        <tr class="selectable @(index == _selected ? "selected" : "")" @onclick="() => _selected = index" @ondblclick="Open">
                            <td>@course.Code</td>
                            <td>@course.Title</td>
                            <td>@course.Semester</td>
                            <td class="num">@(course.Percentage is decimal p ? Percent(p) : "-")</td>
                            <td class="center"><GradeText Grade="@course.FinalGrade" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="win-footer">
        <button class="btn btn-secondary" style="min-width:130px" @onclick="SignOut">Sign out</button>
        <span class="status">@Summary</span>
        <div class="right">
            <button class="btn btn-primary" style="min-width:160px" disabled="@(_selected < 0)" @onclick="Open">View marks</button>
        </div>
    </div>
</DesktopWindow>

@code {
    private IReadOnlyList<StudentCourseResult> _courses = Array.Empty<StudentCourseResult>();
    private int _selected = -1;

    private string Summary
    {
        get
        {
            var graded = _courses.Where(c => c.IsGraded).ToList();
            return graded.Count == 0
                ? $"{_courses.Count} enrolled courses{Dot}no grades released yet"
                : $"{_courses.Count} enrolled courses{Dot}{graded.Count} graded{Dot}average {Percent(graded.Average(c => c.Percentage!.Value))}";
        }
    }

    protected override void OnInitialized()
    {
        if (EnsureRole(UserRole.Student))
        {
            _courses = Session.Results.GetCourses(Session.User!.StudentId!.Value);
            _selected = _courses.Count > 0 ? 0 : -1;
        }
    }

    private void Open()
    {
        if (_selected >= 0)
        {
            Nav.NavigateTo($"student/courses/{_courses[_selected].CourseId}");
        }
    }

    private void OnGridKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Open();
            return;
        }

        _selected = MoveSelection(e, _selected, _courses.Count);
    }
}
