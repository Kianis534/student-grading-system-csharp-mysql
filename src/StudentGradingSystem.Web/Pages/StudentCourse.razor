@page "/student/courses/{CourseId:int}"
@inherits DemoPage

<PageTitle>Course marks - Student Grading System demo</PageTitle>

@if (_details is null)
{
    return;
}

<DesktopWindow Title="@($"Student Grading System - {_details.Course.Code}")" Width="860" Height="600" OnClose="Back" CloseLabel="Close (back to your courses)"
               HeaderTitle="@($"{_details.Course.Code} · {_details.Course.Title}")"
               HeaderSubtitle="@($"{Session.User?.DisplayName}{Dot}{_details.Course.Semester}")">
    <div class="result-block">
        <div class="grade-tile">
            <div class="letter">@(_details.Course.FinalGrade ?? "-")</div>
            <small>@(_details.Course.IsGraded ? "FINAL GRADE" : "NOT GRADED")</small>
        </div>
        <div>
            @if (_details.Course.IsGraded)
            {
                <h2>@Percent(_details.Course.Percentage!.Value) overall</h2>
                <p>Based on @_details.Activities.Count assessments worth @Format(Assessed)% of the course.</p>
            }
            else if (_details.Activities.Count == 0)
            {
                <h2>No assessments have been set up yet</h2>
                <p>Your instructor hasn't added any assessments to this course.</p>
            }
            else
            {
                <h2>@Format(Earned)% earned so far</h2>
                <p>
                    @_details.Activities.Count(a => a.ObtainedMarks.HasValue) of @_details.Activities.Count assessments marked,
                    covering @Format(Assessed)% of the final grade. The final grade appears once your instructor releases it.
                </p>
            }
        </div>
    </div>
    <div class="win-content tight">
        <div class="grid-wrap">
            <table class="grid">
                <thead>
                    <tr>
                        <th class="fill">Assessment</th>
                        <th class="num" style="width:120px">Obtained</th>
                        <th class="num" style="width:100px">Out of</th>
                        <th class="num" style="width:110px">Weightage</th>
                        <th class="num" style="width:170px">Counts toward grade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ActivityResult activity in _details.Activities)
                    {
                        <tr>
                            <td>@activity.ActivityName</td>
                            <td class="num bold">@(activity.ObtainedMarks is decimal m ? Format(m) : "Not marked")</td>
                            <td class="num">@Format(activity.TotalMarks)</td>
                            <td class="num">@Format(activity.Weightage)%</td>
                            <td class="num">@Percent(activity.Contribution)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="win-footer">
        <button class="btn btn-secondary" style="min-width:150px" @onclick="Back">Back to courses</button>
    </div>
</DesktopWindow>

@code {
    [Parameter]
    public int CourseId { get; set; }

    private CourseDetails? _details;

    private decimal Assessed => _details?.Activities.Sum(a => a.Weightage) ?? 0m;

    private decimal Earned => _details?.Activities.Sum(a => a.Contribution) ?? 0m;

    protected override async Task OnParametersSetAsync()
    {
        if (!EnsureRole(UserRole.Student))
        {
            return;
        }

        _details = Session.Results.GetCourseDetails(Session.User!.StudentId!.Value, CourseId);
        if (_details is null)
        {
            await Dialogs.WarningAsync("You are not enrolled in this course.");
            Back();
        }
    }

    private void Back() => Nav.NavigateTo("student");
}
