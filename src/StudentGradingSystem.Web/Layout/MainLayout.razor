@inherits LayoutComponentBase
@implements IDisposable
@inject DemoSession Session
@inject NavigationManager Nav

<div class="preview-strip" role="note">
    <span><strong>Live preview</strong> of the Windows desktop app &middot; sample data in your browser only &middot; resets when you reload.</span>
    @if (Session.IsSignedIn)
    {
        <button class="link" title="Undo every change you made in this demo" @onclick="ResetDemo">Reset demo data</button>
    }
    else
    {
        <span class="quick">
            <button type="button" disabled="@_busy" @onclick="() => QuickSignIn(true)">Try as instructor</button>
            <button type="button" disabled="@_busy" @onclick="() => QuickSignIn(false)">Try as student</button>
        </span>
    }
    <a href="@RepoUrl#getting-started" target="_blank" rel="noopener">Get the real app (MySQL)</a>
</div>

<div class="stage">
    @Body
</div>

<p class="stage-note">
    Browser version of the desktop app, built with C# and Blazor WebAssembly. It mirrors the real windows but won't match them pixel for pixel.
    <a href="@RepoUrl" target="_blank" rel="noopener">Source code and desktop screenshots on GitHub</a>
</p>

<MessageBoxHost />

@code {
    private const string RepoUrl = "https://github.com/Kianis534/student-grading-system-csharp-mysql";
    private bool _busy;

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task QuickSignIn(bool instructor)
    {
        _busy = true;
        try
        {
            AuthenticatedUser? user = instructor
                ? await Session.SignInAsync(StudentGradingSystem.Data.InMemory.DemoData.InstructorUsername, StudentGradingSystem.Data.InMemory.DemoData.InstructorPassword)
                : await Session.SignInAsync(StudentGradingSystem.Data.InMemory.DemoData.StudentUsername, StudentGradingSystem.Data.InMemory.DemoData.StudentPassword);
            if (user is not null)
            {
                Nav.NavigateTo(Session.HomeUrl);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetDemo()
    {
        Session.Reset();
        Nav.NavigateTo(string.Empty);
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
