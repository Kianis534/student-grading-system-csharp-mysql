<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RootNamespace>StudentGradingSystem.Web</RootNamespace>
    <Description>Live in-browser demo of the Student Grading System (Blazor WebAssembly, in-memory data).</Description>
    <!-- Smaller download: the demo only needs invariant number and date formatting. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudentGradingSystem.Core\StudentGradingSystem.Core.csproj" />
    <ProjectReference Include="..\StudentGradingSystem.Data.InMemory\StudentGradingSystem.Data.InMemory.csproj" />
  </ItemGroup>

</Project>
