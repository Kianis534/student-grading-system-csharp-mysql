<Project>
  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <Product>Student Grading System</Product>
    <Authors>Muhammad Abdullah Raja</Authors>
    <Copyright>Copyright (c) 2025-2026 Muhammad Abdullah Raja</Copyright>
    <Version>1.2.0</Version>
    <RepositoryUrl>https://github.com/Kianis534/student-grading-system-csharp-mysql</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- CI builds (GitHub Actions sets CI=true) must be warning-free. -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
